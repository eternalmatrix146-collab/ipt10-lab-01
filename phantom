#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
|--------------------------------------------------------------------------
| PHANTOM command-line interface
|--------------------------------------------------------------------------
|   php phantom start [port]       start MySQL, prepare the DB, open the browser, serve
|   php phantom serve [port]       start the development server
|   php phantom db:create          create the database if it does not exist
|   php phantom migrate            run pending migrations
|   php phantom migrate:fresh --seed
|   php phantom test [filter]      run the unit tests
*/

use Database\Seeders\DatabaseSeeder;
use Phantom\Console\Console;
use Phantom\Database\DB;
use Phantom\Database\Migrator;
use Phantom\Testing\TestRunner;

$app = require __DIR__ . '/bootstrap/app.php';
$console = new Console();

$migrator = static fn (Console $c) => new Migrator(DB::connection(), __DIR__ . '/database/migrations', fn ($line) => $c->line("  {$line}"));

$serve = static function (int $port, Console $c): int {
    $c->info("Midnight Market running at http://localhost:{$port}  (Ctrl+C to stop)");
    passthru(sprintf('"%s" -S localhost:%d -t "%s" "%s"', PHP_BINARY, $port, __DIR__ . '/public', __DIR__ . '/public/index.php'), $code);
    return (int) $code;
};

$portOpen = static function (string $host, int $port): bool {
    $socket = @fsockopen($host, $port, $errno, $errstr, 0.5);
    if ($socket === false) {
        return false;
    }
    fclose($socket);
    return true;
};

$console->command('serve', 'Start the PHP development server (default port 8000)', function (array $args, Console $c) use ($serve): int {
    return $serve((int) ($args[0] ?? 8000), $c);
});

$console->command('start', 'One command: start MySQL, prepare the database, open the browser, serve', function (array $args, Console $c) use ($serve, $portOpen, $migrator): int {
    $cfg = config('database');
    $host = (string) $cfg['host'];
    $dbPort = (int) $cfg['port'];

    // 1. MySQL — start XAMPP's server in the background if nothing is listening yet.
    if ($portOpen($host, $dbPort)) {
        $c->line('  MySQL is already running.');
    } else {
        $xampp = rtrim((string) env('XAMPP_PATH', 'C:\\xampp'), '\\/');
        $mysqld = $xampp . '\\mysql\\bin\\mysqld.exe';
        if (PHP_OS_FAMILY !== 'Windows' || !is_file($mysqld)) {
            $c->error("MySQL is not running on {$host}:{$dbPort} and {$mysqld} was not found. Start MySQL yourself (XAMPP Control Panel), then run this again.");
            return 1;
        }
        $c->line('  Starting MySQL…');
        // Start-Process detaches mysqld, so it keeps running after this window closes.
        // The my.ini path is quoted because XAMPP may live under a folder with spaces (e.g. Program Files).
        exec(sprintf(
            'powershell -NoProfile -Command "Start-Process -FilePath \'%s\' -ArgumentList \'--defaults-file=\"%s\"\',\'--standalone\' -WindowStyle Hidden"',
            $mysqld,
            $xampp . '\\mysql\\bin\\my.ini'
        ));
        $deadline = microtime(true) + 30;
        while (!$portOpen($host, $dbPort)) {
            if (microtime(true) > $deadline) {
                $c->error('MySQL did not start within 30 seconds. Try starting it from the XAMPP Control Panel.');
                return 1;
            }
            usleep(500_000);
        }
        sleep(1); // give it a moment to accept logins
        $c->line('  MySQL started.');
    }

    // 2. Database — create, migrate, and seed demo data on the very first run only.
    $name = (string) $cfg['database'];
    if (!preg_match('/^[A-Za-z0-9_]+$/', $name)) {
        $c->error('Invalid database name in .env.');
        return 1;
    }
    $pdo = new PDO(sprintf('mysql:host=%s;port=%d;charset=utf8mb4', $host, $dbPort), $cfg['username'], $cfg['password']);
    $pdo->exec("CREATE DATABASE IF NOT EXISTS `{$name}` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci");

    $ran = $migrator($c)->migrate();
    $c->line($ran ? '  Applied ' . count($ran) . ' migration(s).' : '  Database is up to date.');
    if (DB::table('products')->count() === 0) {
        (new DatabaseSeeder(DB::connection()))->run();
        $c->line('  Loaded demo data.');
    }

    // 3. Web server — first free port from 8000 (or the one given), then open the browser.
    $port = (int) ($args[0] ?? 8000);
    while ($portOpen('127.0.0.1', $port)) {
        $port++;
    }
    $url = "http://localhost:{$port}";
    if (PHP_OS_FAMILY === 'Windows') {
        pclose(popen('start "" ' . $url, 'r'));
    }

    $c->line('');
    return $serve($port, $c);
});

$console->command('db:create', 'Create the configured MySQL database if it is missing', function (array $args, Console $c): int {
    $cfg = config('database');
    $pdo = new PDO(sprintf('mysql:host=%s;port=%s;charset=utf8mb4', $cfg['host'], $cfg['port']), $cfg['username'], $cfg['password']);
    $name = (string) $cfg['database'];
    if (!preg_match('/^[A-Za-z0-9_]+$/', $name)) {
        $c->error('Invalid database name.');
        return 1;
    }
    $pdo->exec("CREATE DATABASE IF NOT EXISTS `{$name}` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci");
    $c->info("Database `{$name}` is ready.");
    return 0;
});

$console->command('migrate', 'Run pending database migrations', function (array $args, Console $c) use ($migrator): int {
    $ran = $migrator($c)->migrate();
    $c->info($ran ? 'Migrated ' . count($ran) . ' file(s).' : 'Nothing to migrate.');
    return 0;
});

$console->command('migrate:rollback', 'Undo the last batch of migrations', function (array $args, Console $c) use ($migrator): int {
    $done = $migrator($c)->rollback();
    $c->info($done ? 'Rolled back ' . count($done) . ' file(s).' : 'Nothing to roll back.');
    return 0;
});

$console->command('migrate:fresh', 'Drop all tables and re-run every migration (--seed to seed)', function (array $args, Console $c) use ($migrator): int {
    $migrator($c)->fresh();
    $c->info('Database rebuilt.');
    if (in_array('--seed', $args, true)) {
        (new DatabaseSeeder(DB::connection()))->run();
        $c->info('Demo data seeded.');
    }
    return 0;
});

$console->command('migrate:status', 'Show which migrations have run', function (array $args, Console $c) use ($migrator): int {
    foreach ($migrator($c)->status() as $row) {
        $c->line(($row['ran'] ? "\033[32m  ran  \033[0m" : "\033[33mpending\033[0m") . "  {$row['name']}" . ($row['batch'] ? "  (batch {$row['batch']})" : ''));
    }
    return 0;
});

$console->command('db:seed', 'Insert demo data', function (array $args, Console $c): int {
    (new DatabaseSeeder(DB::connection()))->run();
    $c->info('Demo data seeded.');
    return 0;
});

$console->command('routes', 'List all registered routes', function (array $args, Console $c) use ($app): int {
    foreach ($app->router()->routes() as $route) {
        $handler = $route->getHandler();
        $action = is_array($handler) ? class_basename($handler[0]) . '@' . $handler[1] : 'Closure';
        $c->line(sprintf(
            "  \033[33m%-7s\033[0m %-38s %-36s %s",
            $route->getMethod(),
            $route->getPath(),
            $action,
            implode(',', $route->getMiddleware())
        ));
    }
    return 0;
});

$console->command('test', 'Run the test suite (optional name filter)', function (array $args): int {
    return (new TestRunner(__DIR__ . '/tests'))->run($args[0] ?? null);
});

$console->command('agent:ping', 'Test every NVIDIA API key and tool calling against the configured model', function (array $args, Console $c) use ($app): int {
    $client = $app->make(App\Services\AI\NimClient::class);
    if (!$client->isConfigured()) {
        $c->error('No NVIDIA API key in .env (NVIDIA_API_KEY_1..3) — Rook will run in offline mode.');
        return 1;
    }
    $c->line('Model: ' . $client->model());
    $working = null;
    foreach ($client->keys() as $slot => $key) {
        $label = 'Key ' . ($slot + 1); // never print key material
        $started = microtime(true);
        try {
            $response = $client->createChatCompletion([
                'messages' => [['role' => 'user', 'content' => 'Reply with exactly: Rook online.']],
                'reasoning_effort' => 'none',
                'max_tokens' => 64,
            ], $slot);
            $c->info(sprintf('%s OK in %.1fs — "%s"', $label, microtime(true) - $started, App\Services\AI\NimAgent::text($response)));
            $working ??= $slot;
        } catch (App\Services\AI\AiException $e) {
            $c->error("{$label} FAILED [{$e->kind()}]: {$e->getMessage()}");
        }
    }
    if ($working === null) {
        return 1;
    }

    // The agent needs tool calling: make sure the model asks for a tool when it should.
    $tool = new App\Services\AI\Tool('get_store_hours', 'Returns the store opening hours.', [], fn () => App\Services\AI\ToolResult::ok('always open'));
    try {
        $response = $client->createChatCompletion([
            'messages' => [['role' => 'user', 'content' => 'When is the store open? Use the tool.']],
            'tools' => [$tool->definition()],
            'tool_choice' => 'auto',
        ], $working);
    } catch (App\Services\AI\AiException $e) {
        $c->error("Tool calling FAILED [{$e->kind()}]: {$e->getMessage()}");
        return 1;
    }
    $call = $response['choices'][0]['message']['tool_calls'][0]['function']['name'] ?? null;
    if ($call === 'get_store_hours') {
        $c->info('Tool calling OK — the model called get_store_hours.');
        return 0;
    }
    $c->error('Tool calling did not trigger (finish_reason: ' . ($response['choices'][0]['finish_reason'] ?? '?') . ').');
    return 1;
});

$console->command('agent:bench', 'Measure AI latency: agent:bench [runs=3] [model]', function (array $args, Console $c) use ($app): int {
    $runs = max(1, (int) ($args[0] ?? 3));
    $config = (array) config('services.nvidia');
    if (isset($args[1])) {
        $config['model'] = $args[1];
    }
    $client = new App\Services\AI\NimClient($app->make(Phantom\Http\Client\HttpClient::class), $config);
    if (!$client->isConfigured()) {
        $c->error('No NVIDIA API key in .env (NVIDIA_API_KEY_1..3).');
        return 1;
    }
    $shop = $app->make(App\Services\AI\ShopToolkit::class);
    $system = App\Services\AI\Prompts::shop();
    $effort = (string) ($config['reasoning_effort'] ?? 'none');
    $c->line("Model: {$client->model()} · keys: " . count($client->keys()) . " · runs per case: {$runs} · default effort: {$effort}");

    $ask = static fn (string $text) => [['role' => 'system', 'content' => $system], ['role' => 'user', 'content' => $text]];
    $cases = [];
    foreach (['none', 'medium', 'high'] as $level) {
        $cases["plain reply, {$level}"] = fn () => $client->createChatCompletion([
            'messages' => $ask('In one sentence, what makes a good gift for a night owl?'),
            'reasoning_effort' => $level,
        ]);
    }
    $cases["tool call, {$effort}"] = fn () => $client->createChatCompletion([
        'messages' => $ask('Find me a mask under 800 pesos.'),
        'tools' => $shop->registry()->definitions(),
        'tool_choice' => 'auto',
    ]);
    $cases["full Rook turn, {$effort}"] = fn () => (new App\Services\AI\NimAgent($client, $shop->registry(), $system))
        ->run([], 'Find me a mask under 800 pesos.', 'logged_in: no; shopper_currency: PHP');

    $failed = false;
    foreach ($cases as $label => $case) {
        $times = [];
        $errors = [];
        $notes = [];
        for ($i = 0; $i < $runs; $i++) {
            $started = microtime(true);
            try {
                $result = $case();
                $times[] = microtime(true) - $started;
                if ($result instanceof App\Services\AI\AgentResult) {
                    $notes[] = count($result->actions) . ' tool(s), ' . $result->outputTokens . ' out-tokens';
                } else {
                    $notes[] = ($result['usage']['completion_tokens'] ?? '?') . ' out-tokens'
                        . (str_starts_with($label, 'tool') ? (isset($result['choices'][0]['message']['tool_calls']) ? ', tool called' : ', NO tool call') : '');
                }
            } catch (App\Services\AI\AiException $e) {
                $errors[] = $e->kind() . ': ' . mb_substr($e->getMessage(), 0, 120);
            }
        }
        if ($times === []) {
            $failed = true;
            $c->error(sprintf('  %-24s FAILED  %s', $label, implode(' | ', array_unique($errors))));
            continue;
        }
        sort($times);
        $c->line(sprintf(
            '  %-24s median %5.1fs   min %5.1fs   max %5.1fs   [%s]%s',
            $label,
            $times[intdiv(count($times), 2)],
            $times[0],
            end($times),
            implode('; ', array_unique($notes)),
            $errors ? '   errors: ' . implode(' | ', array_unique($errors)) : ''
        ));
    }
    return $failed ? 1 : 0;
});

exit($console->run($argv));
