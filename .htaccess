# When the project folder itself is the web root (e.g. XAMPP htdocs/midnight-market),
# route every request into /public so framework, config and .env are never exposed.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
