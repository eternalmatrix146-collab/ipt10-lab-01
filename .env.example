# ---------------------------------------------------------------
# Midnight Market — environment configuration
# Copy to .env and adjust. Never commit your real .env.
# ---------------------------------------------------------------
APP_NAME="Midnight Market"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

# MySQL / MariaDB (XAMPP defaults)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=midnight_market
DB_USERNAME=root
DB_PASSWORD=

# NVIDIA NIM (https://build.nvidia.com) — Rook's AI model. Paste up to three keys
# (nvapi-...); requests rotate across them to stay under each key's rate limit.
# Leave all three empty to run Rook in offline mode.
NVIDIA_API_KEY_1=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# none = fastest (default, ~3-5 s per Rook reply), medium = ~2x slower, high = slowest
NVIDIA_REASONING_EFFORT=none
NVIDIA_MAX_TOKENS=8192

# Optional: path to a CA bundle if PHP's cURL cannot verify HTTPS certificates
# (common on Windows/XAMPP). Download cacert.pem from https://curl.se/docs/caextract.html
CURL_CA_BUNDLE=
